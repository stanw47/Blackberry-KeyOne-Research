# Firmware blobs and extracted autoloaders (large, not redistributed)
firmware/**
!firmware/.gitkeep

# Large firmware archives / dumps / images
*.rar
*.7z
*.zip
*.exe
*.img
*.mbn
*.elf
*.xml

# Huge generated dumps
recon/kallsyms_full.txt

# Third-party exploit payloads / binaries (analysis only; obtain from upstream)
exploit/key2-unlock/*.bin
exploit/key2-unlock/*.exe
exploit/key2-unlock/*.dll
exploit/key2-unlock/*.resources

# Extracted trees
firmware/**/target/**
firmware/**/host/**

# Downloads / temp
*.megatmp*
*.log

# Keys and secrets
id_rsa
id_rsa.pub
*.pem
*.key
*credentials*

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Third-party reference source (cloned, not redistributed)
ref/lk_msm8953/
